                    },
                    {
                      "type": "text",
                      "id": "bkBe6",
                      "name": "Un membre vérifié peut p",
                      "fill": "#333333",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Un membre vérifié peut proposer un commerce réel de sa ville. La proposition est vérifiée par l'équipe (existence, adresse, doublon) avant l'attribution des 20 points. Il n'y a pas de limite au nombre de commerces proposés. Si le commerce existe déjà, tu peux le soutenir : les soutiens et les votes ne rapportent pas de points.",
                      "lineHeight": 1.65,
                      "fontFamily": "$font-body",
                      "fontSize": 16
                    },
                    {
                      "type": "text",
                      "id": "nMtY5",
                      "name": "Un commerce proposé ou c",
                      "fill": "#333333",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Un commerce proposé ou contacté n'est jamais présenté comme partenaire. Les informations de partenariat ne sont publiées qu'avec l'accord du commerçant.",
                      "lineHeight": 1.65,
                      "fontFamily": "$font-body",
                      "fontSize": 16
                    }
                  ]
